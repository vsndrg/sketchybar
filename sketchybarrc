#!/usr/bin/env lua

local home = os.getenv("HOME")
local dir = os.getenv("CONFIG_DIR") or (home .. "/.config/sketchybar")
package.path = dir .. "/?.lua;" .. dir .. "/?/init.lua;" .. package.path
package.cpath = package.cpath .. ";" .. home .. "/.local/share/sketchybar_lua/?.so"

-- Native helper (squircles, wallpaper accent, layout, color picker).
os.execute("make -s -C '" .. dir .. "/helper' >/dev/null 2>&1")

sbar = require("sketchybar")
local config = require("config")
local theme = require("lib.theme")
local frame = require("lib.frame")

frame.hold()
sbar.begin_config()

sbar.bar({
  position = "top",
  height = config.bar.height,
  color = 0x00000000,
  border_width = 0,
  shadow = false,
  blur_radius = 0,
  padding_left = config.bar.margin,
  padding_right = config.bar.margin,
  topmost = "off",
  sticky = true,
  font_smoothing = false,
})

sbar.default({
  updates = "when_shown",
  padding_left = 0,
  padding_right = 0,
  icon = {
    font = { family = config.font.text, style = config.font.bold, size = config.font.size },
    color = 0xfff5f5f7,
    padding_left = 0,
    padding_right = 0,
  },
  label = {
    font = { family = config.font.text, style = config.font.medium, size = config.font.size },
    color = 0xfff5f5f7,
    padding_left = 0,
    padding_right = 0,
  },
  background = { drawing = false, color = 0, border_width = 0, corner_radius = 0 },
  popup = { background = { drawing = false, color = 0, border_width = 0 }, blur_radius = 0 },
})

-- left: workspaces (one fixed-width item, edge → notch)
require("items.spaces")

-- right: layout │ battery │ clock (one fixed-width item, notch → edge)
local status = require("items.status")
require("items.theme_menu")(status.anchor)

-- Geometry (notch, narrowest display) is read at startup: re-read it when
-- displays come and go.
local displays = sbar.add("item", "displays.watcher", { drawing = false, updates = true })
local reload_pending = false
displays:subscribe("display_change", function()
  if reload_pending then return end
  reload_pending = true
  sbar.delay(1.0, function() sbar.exec("sketchybar --reload") end)
end)

sbar.end_config()
frame.release()

theme.apply()

-- The daemon fires layout_change / wallpaper_change; start it once items exist.
os.execute("pkill -f 'barhelper daemon' 2>/dev/null; (nohup '" .. config.helper .. "' daemon >/dev/null 2>&1 &)")

sbar.event_loop()
