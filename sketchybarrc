#!/usr/bin/env lua

local home = os.getenv("HOME")
local dir = os.getenv("CONFIG_DIR") or (home .. "/.config/sketchybar")
package.path = dir .. "/?.lua;" .. dir .. "/?/init.lua;" .. package.path
package.cpath = package.cpath .. ";" .. home .. "/.local/share/sketchybar_lua/?.so"

-- Native helper (draws the bar, keyboard layout, Sidecar, screen corners).
os.execute("make -s -C '" .. dir .. "/helper' >/dev/null 2>&1")

sbar = require("sketchybar")
local config = require("config")
local theme = require("lib.theme")
local sh = require("lib.sh")

sbar.begin_config()

-- The bar is drawn by the helper daemon (Liquid Glass windows, see
-- lib/bar.lua); sketchybar only runs the logic and delivers the events.
sbar.bar({ hidden = "on", topmost = "off", sticky = true, height = config.bar.height })

-- left: workspaces
require("items.spaces")
-- right: layout │ battery │ clock
require("items.status")
-- right click anywhere on the bar: text weight
require("items.theme_menu")

sbar.end_config()

theme.apply()

-- The daemon draws the bar and fires layout_change / minute_change / menu_select;
-- start it once items exist.
sh.run("pkill -f 'barhelper daemon' 2>/dev/null; (nohup '" .. config.helper .. "' daemon " .. config.screen_corner
  .. " >/dev/null 2>&1 &)")

sbar.event_loop()
